// Nova HRMS — Administration (Master Data) schema.
//
// SQLite is the local development datasource. To move to PostgreSQL later
// (Supabase, Neon, self-hosted), change `provider` below to "postgresql",
// point DATABASE_URL at the Postgres connection string, and run
// `prisma migrate dev` — no application code needs to change, since every
// consumer goes through the repository layer in src/repositories/.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Company {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches Branch[]

  // Leave Management back-relations — nullable on the Leave side (null =
  // applies globally / not company-scoped), so these arrays only ever hold
  // the records explicitly scoped to this company.
  leavePolicies LeavePolicy[]
  leaveRequests LeaveRequest[]
  holidays      Holiday[]

  @@map("companies")
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  // Leave Management back-relations — same nullable-scoping note as Company.
  leavePolicies LeavePolicy[]
  leaveRequests LeaveRequest[]
  holidays      Holiday[]

  @@index([companyId])
  @@map("branches")
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  positions Position[]

  @@map("departments")
}

model Position {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])

  @@index([departmentId])
  @@map("positions")
}

model Grade {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("grades")
}

model WorkSchedule {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// "WEEKLY" (workingDays applies) or "ROTATING" (rotationOnDays/
  /// rotationOffDays/rotationStartDate applies). Leave Policy Resolution
  /// Engine (src/lib/leave/leave-policy-resolution-service.ts) is the only
  /// intended reader of these fields — never assume Mon-Fri elsewhere.
  scheduleType String @default("WEEKLY")
  /// Comma-separated weekday codes (MON,TUE,WED,THU,FRI,SAT,SUN) — which
  /// days are working days. Used when scheduleType = "WEEKLY".
  workingDays String @default("MON,TUE,WED,THU,FRI")
  /// Consecutive working days per cycle. Used when scheduleType = "ROTATING".
  rotationOnDays Int?
  /// Consecutive off days per cycle. Used when scheduleType = "ROTATING".
  rotationOffDays Int?
  /// Anchor date the rotation cycle is calculated from. Used when
  /// scheduleType = "ROTATING".
  rotationStartDate DateTime?

  @@map("work_schedules")
}

model EmploymentType {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("employment_types")
}

// ---------------------------------------------------------------------------
// Leave Management — Phase 1 (Architecture & Foundation only)
//
// Ledger-based by design: no model or field here ever stores a "remaining
// balance" — LeaveLedgerEntry rows (signed amount, one entryType per row) are
// the only source of truth, and every balance is a SUM() projection computed
// in application code (src/types/leave.ts's LeaveBalanceStatement), never
// persisted. LeaveLedgerEntry is append-only on purpose: there is no update
// path in the repository layer, only find/create — a correction is a new
// reversing entry, never an edit, so history is always reconstructable.
//
// employeeId is a plain String on every model below, not a @relation — the
// Employee module has no Prisma table yet (still src/data/employee-directory
// .ts, in-memory). This mirrors how the rest of the codebase already treats
// that boundary (e.g. EmployeeProfile.terminationRecordId is a bare
// reference, not a live FK). When Employee migrates to Prisma, these become
// real relations without changing any call site.
// ---------------------------------------------------------------------------

enum LeaveUnit {
  DAYS
  HOURS
}

enum LeaveEntryType {
  OPENING_BALANCE
  IMPORTED_BALANCE
  ACCRUAL
  CARRY_FORWARD
  LEAVE_TAKEN
  LEAVE_CANCELLED
  MANUAL_ADJUSTMENT
  EXPIRY
  SETTLEMENT
  ENCASHMENT
}

enum LeaveEntryReferenceType {
  LEAVE_REQUEST
  MANUAL
  IMPORT
  ACCRUAL_RUN
  SYSTEM
}

// Deliberately not named "LeaveRequestStatus" — that name already exists as
// a hand-written 3-state TS union in src/types/employee-profile.ts, used by
// the placeholder LeaveTab. Naming this differently avoids the confusion of
// two different-shaped things sharing a name, even though Prisma enums live
// in a separate generated module.
enum LeaveRequestLifecycleStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

enum LeaveApprovalDecision {
  PENDING
  APPROVED
  REJECTED
}

enum LeaveAccrualRunStatus {
  PENDING
  COMPLETED
  FAILED
}

enum LeaveAccrualMethod {
  NONE
  MONTHLY
  ANNUAL
  ANNIVERSARY
}

/// Catalog identity only (code/name/unit) — same shape as Department/Grade.
/// Behavioral rules live on LeavePolicy, not here, so a leave type's
/// identity never has to change just because its rules do.
model LeaveType {
  id              String    @id @default(cuid())
  code            String    @unique
  name            String
  description     String?
  unit            LeaveUnit
  isPaid          Boolean   @default(true)
  requiresBalance Boolean   @default(true)
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  policies      LeavePolicy[]
  requests      LeaveRequest[]
  ledgerEntries LeaveLedgerEntry[]

  @@map("leave_types")
}

/// The configurable rules for a LeaveType — versionable (effectiveFrom/To)
/// and scopable per company/branch (both nullable; null = global default).
/// Which policy applies to a given employee is resolution logic, not stored
/// here — deferred to a future phase.
model LeavePolicy {
  id                       String              @id @default(cuid())
  leaveTypeId              String
  leaveType                LeaveType           @relation(fields: [leaveTypeId], references: [id])
  companyId                String?
  company                  Company?            @relation(fields: [companyId], references: [id])
  branchId                 String?
  branch                   Branch?             @relation(fields: [branchId], references: [id])
  effectiveFrom            DateTime
  effectiveTo              DateTime?
  entitlementUnitsPerYear  Float?
  accrualMethod            LeaveAccrualMethod  @default(NONE)
  requiresApproval         Boolean             @default(true)
  carryForwardAllowed      Boolean             @default(false)
  carryForwardMaxUnits     Float?
  carryForwardExpiryMonths Int?
  encashmentAllowed        Boolean             @default(false)
  /// "BLOCK" | "WARN" — whether a leave request exceeding the available
  /// balance is rejected outright or merely flagged. Configured per policy,
  /// never inferred from a leave type's name/code — an admin makes Annual
  /// Leave BLOCK by configuring it that way, not because this engine treats
  /// "Annual Leave" as special.
  balanceValidationMode    String              @default("WARN")
  active                   Boolean             @default(true)
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt

  accrualRuns LeaveAccrualRun[]

  @@index([leaveTypeId])
  @@index([companyId])
  @@index([branchId])
  @@map("leave_policies")
}

/// A leave request's lifecycle record. Phase 1 only reads these — no action
/// exists yet that creates one in a non-DRAFT state, since submission and
/// approval are explicitly out of scope for this phase.
model LeaveRequest {
  id              String                      @id @default(cuid())
  employeeId      String
  leaveTypeId     String
  leaveType       LeaveType                   @relation(fields: [leaveTypeId], references: [id])
  companyId       String?
  company         Company?                    @relation(fields: [companyId], references: [id])
  branchId        String?
  branch          Branch?                     @relation(fields: [branchId], references: [id])
  startDate       DateTime
  endDate         DateTime
  requestedUnits  Float
  status          LeaveRequestLifecycleStatus @default(DRAFT)
  reason          String?
  submittedAt     DateTime?
  decidedAt       DateTime?
  decidedBy       String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  approvals LeaveApproval[]

  @@index([employeeId])
  @@index([leaveTypeId])
  @@map("leave_requests")
}

/// One row per decision. sequence exists so a future multi-step workflow
/// engine can insert additional rows per request without a redesign — Phase
/// 1 never writes more than one row per request, and nothing auto-transitions
/// LeaveRequest.status based on this table yet.
model LeaveApproval {
  id                 String                 @id @default(cuid())
  leaveRequestId     String
  leaveRequest       LeaveRequest           @relation(fields: [leaveRequestId], references: [id])
  sequence           Int                    @default(1)
  approverEmployeeId String
  decision           LeaveApprovalDecision  @default(PENDING)
  decidedAt          DateTime?
  comment            String?
  createdAt          DateTime               @default(now())

  @@index([leaveRequestId])
  @@map("leave_approvals")
}

/// The ledger. Append-only — see file header. referenceType/referenceId is
/// a soft polymorphic pointer (no relation, since it can point at four
/// different tables), resolved by the reader knowing referenceType, the same
/// way EmployeeProfile.terminationRecordId is a bare reference elsewhere in
/// this codebase.
model LeaveLedgerEntry {
  id            String                   @id @default(cuid())
  employeeId    String
  leaveTypeId   String
  leaveType     LeaveType                @relation(fields: [leaveTypeId], references: [id])
  companyId     String?
  entryType     LeaveEntryType
  amount        Float
  unit          LeaveUnit
  effectiveDate DateTime
  referenceType LeaveEntryReferenceType?
  referenceId   String?
  note          String?
  createdBy     String
  createdAt     DateTime                 @default(now())

  @@index([employeeId, leaveTypeId])
  @@index([referenceType, referenceId])
  @@map("leave_ledger_entries")
}

/// The migration-batch entity — what makes Opening Balance a first-class,
/// traceable concept rather than an untyped Manual Adjustment. Each row this
/// produces is a LeaveLedgerEntry with entryType=IMPORTED_BALANCE and
/// referenceType=IMPORT, referenceId=this import's id.
model LeaveOpeningBalanceImport {
  id           String   @id @default(cuid())
  importedBy   String
  importedAt   DateTime @default(now())
  sourceSystem String?
  effectiveDate DateTime
  note         String?

  @@map("leave_opening_balance_imports")
}

/// Execution-log placeholder — records that an accrual batch ran and how
/// many ledger entries it produced. No accrual calculation exists yet; this
/// table only gives Phase 2's engine somewhere to log to from day one.
model LeaveAccrualRun {
  id                  String                 @id @default(cuid())
  leavePolicyId       String
  leavePolicy         LeavePolicy            @relation(fields: [leavePolicyId], references: [id])
  periodStart         DateTime
  periodEnd           DateTime
  status              LeaveAccrualRunStatus  @default(PENDING)
  runAt               DateTime?
  entriesCreatedCount Int                    @default(0)
  createdAt           DateTime               @default(now())

  @@index([leavePolicyId])
  @@map("leave_accrual_runs")
}

/// Generic, per-entity audit trail — Leave has several aggregate roots
/// (Type, Policy, Request, Ledger), unlike Employee/Offboarding which embed
/// one auditLog on a single EmployeeProfile. entityType/entityId stand in
/// for that embedding. Same field shape as EmployeeProfile's AuditLogEntry
/// (actor/action/timestamp/field/oldValue/newValue) for consistency.
model LeaveAuditLogEntry {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actor      String
  timestamp  DateTime @default(now())
  field      String?
  oldValue   String?
  newValue   String?

  @@index([entityType, entityId])
  @@map("leave_audit_log_entries")
}

/// Calendar data only — no calendar UI/rendering logic here, just the facts
/// a future Leave/Team/Holiday calendar screen would query.
model Holiday {
  id                String   @id @default(cuid())
  name              String
  date              DateTime
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])
  branchId          String?
  branch            Branch?  @relation(fields: [branchId], references: [id])
  recurringAnnually Boolean  @default(false)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([companyId])
  @@index([branchId])
  @@map("holidays")
}

// ---------------------------------------------------------------------------
// Documents — a generic, cross-module attachment system. NOT owned by Leave
// or any other single module: entityType/entityId is a plain polymorphic
// reference (same pattern as LeaveAuditLogEntry's own entityType/entityId),
// so any future module (Employee, Contract, Training, Payroll, Attendance,
// Termination, Performance, ...) registers its own entityType string with
// zero migration. This table stores metadata only — never file bytes.
// storageKey is opaque here; only DocumentStorageProvider
// (src/lib/integrations/document-storage-provider.ts) interprets it, so the
// storage backend (local filesystem today, S3/MinIO/Azure Blob later) can
// change without touching this model or any business logic that reads it.
// ---------------------------------------------------------------------------

model Document {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  category   String?
  fileName   String
  mimeType   String
  fileSize   Int
  storageKey String
  uploadedBy String
  uploadedAt DateTime @default(now())
  /// Not enforced by this module — a future approval workflow can set this
  /// to lock a document from replacement once its parent record is approved.
  immutable  Boolean  @default(false)

  @@index([entityType, entityId])
  @@map("documents")
}

// ---------------------------------------------------------------------------
// Approval Engine — Phase 4A (schema + repositories only, zero behavior)
//
// A single generic engine every future request-type (Leave, Overtime,
// Expense, Business Trip, Asset, Training, Recruitment, Performance,
// Promotion, Transfer, Termination, Salary Change, Disciplinary Action, ...)
// reuses without this engine ever knowing any of those names. Same soft
// polymorphic entityType/entityId pointer as Document/LeaveAuditLogEntry —
// entityType is a plain String with NO master list anywhere in this file or
// in src/lib/approval/: a module registers itself by simply calling the
// public API with its own entityType string, never by editing engine
// source. (Contrast with DocumentEntityType/LeaveAuditEntityType, which
// *are* small const registries living next to their module — this engine
// deliberately skips even that, since owning a registry of every consumer's
// name would itself be a form of coupling to those consumers.)
//
// ApprovalApproverResolutionType stays a closed enum on purpose: its
// members are structural org-chart concepts (a manager, a role, a
// position, "the CEO"), not business rules — the same distinction this
// schema already draws elsewhere between closed/structural enums
// (LeaveEntryType) and open/business-vocabulary strings
// (LeaveAuditLogEntry.action). CUSTOM_RULE + the opaque Json config on
// ApprovalStepDefinition is the escape hatch a future module uses to plug
// in a wholly new resolution strategy (e.g. "cost center owner") via a
// runtime-registered resolver, without adding an enum value here.
//
// No @relation ever points from these models at LeaveRequest, Document, or
// any other business-module table, and no existing model gains a back-
// relation to these — that's what keeps this 100% additive and keeps
// Leave/Document backward compatible. employeeId-shaped fields are plain
// String throughout, mirroring LeaveRequest.employeeId and
// Document.uploadedBy — Employee has no Prisma table yet either.
// ---------------------------------------------------------------------------

enum ApprovalWorkflowVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ApprovalApproverResolutionType {
  SPECIFIC_EMPLOYEE
  DIRECT_MANAGER
  MANAGER_CHAIN_LEVEL
  ROLE
  POSITION
  DEPARTMENT_HEAD
  COMPANY_CEO
  CUSTOM_RULE
}

enum ApprovalQuorumMode {
  ANY_ONE
  ALL
  MAJORITY
}

enum ApprovalInstanceStatus {
  DRAFT
  PENDING
  IN_REVIEW
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
  RETURNED
  CANCELLED
  EXPIRED
}

enum ApprovalStepInstanceStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
  ESCALATED
  EXPIRED
}

enum ApprovalDecision {
  PENDING
  APPROVED
  REJECTED
  RETURNED
}

enum ApprovalActionType {
  CREATED
  VIEWED
  APPROVED
  REJECTED
  RETURNED
  CANCELLED
  DELEGATED
  ESCALATED
  REOPENED
}

enum ApprovalDelegationReason {
  ON_LEAVE
  INACTIVE
  SUSPENDED
  MANUAL
}

/// The "which workflow applies" matcher. Nullable scope fields follow the
/// exact LeavePolicy pattern (null = global default, a specific scope wins)
/// — same resolution order leave-request-service.ts already uses for
/// balanceValidationMode. entityType is unconstrained on purpose (see file
/// header) — this engine never enumerates which modules exist.
model ApprovalWorkflowDefinition {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  description  String?
  entityType   String
  companyId    String?
  branchId     String?
  departmentId String?
  /// Small serializable rule tree, e.g. {field:"amount", op:">", value:5000}.
  /// Evaluated against ApprovalInstance.contextPayload by a later phase's
  /// condition evaluator — never a hardcoded field name here.
  conditionExpression Json?
  /// Higher wins when multiple definitions match the same instance — same
  /// idea as "company-specific overrides global".
  priority     Int      @default(0)
  /// True = exists only as a cloning source (e.g. a starter template for a
  /// new company); a later phase's resolution service excludes templates
  /// from auto-matching a real submission. Doesn't restrict cloning itself
  /// — any definition, template or not, can be cloned.
  isTemplate   Boolean  @default(false)
  active       Boolean  @default(true)
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  versions ApprovalWorkflowVersion[]

  @@index([entityType])
  @@index([companyId])
  @@index([branchId])
  @@index([departmentId])
  @@map("approval_workflow_definitions")
}

/// Immutable once PUBLISHED — a request created today keeps referencing
/// this exact version forever. Editing a published workflow means cloning
/// into a new DRAFT version, never mutating this row's steps in place.
model ApprovalWorkflowVersion {
  id                   String                         @id @default(cuid())
  workflowDefinitionId String
  workflowDefinition   ApprovalWorkflowDefinition     @relation(fields: [workflowDefinitionId], references: [id])
  version              Int
  status               ApprovalWorkflowVersionStatus  @default(DRAFT)
  defaultSlaHours      Int?
  /// Opaque canvas state (viewport/zoom/pan) for a future visual Workflow
  /// Builder — never read by any engine logic, same treatment as
  /// Document.storageKey being opaque outside its storage provider.
  canvasMetadata       Json?
  publishedBy          String?
  publishedAt          DateTime?
  createdBy            String
  createdAt            DateTime                       @default(now())

  steps     ApprovalStepDefinition[]
  instances ApprovalInstance[]

  @@unique([workflowDefinitionId, version])
  @@index([workflowDefinitionId])
  @@map("approval_workflow_versions")
}

/// One row per parallel branch per stepOrder. Every row sharing a stepOrder
/// runs concurrently and ALL must clear before stepOrder+1 activates —
/// that's how "Finance AND HR" is expressed (two rows, same stepOrder,
/// different branchKey). quorumMode governs how many *resolved* people
/// within one branch must decide (a ROLE resolution can yield several).
/// Normalized rather than a JSON graph specifically so a future visual
/// Workflow Builder can CRUD individual steps on a DRAFT version without
/// any schema change.
model ApprovalStepDefinition {
  id                       String                          @id @default(cuid())
  workflowVersionId        String
  workflowVersion          ApprovalWorkflowVersion         @relation(fields: [workflowVersionId], references: [id])
  stepOrder                Int
  branchKey                String                          @default("DEFAULT")
  name                     String
  approverResolutionType   ApprovalApproverResolutionType
  /// Parameters for the resolution type — e.g. {role:"CEO"},
  /// {level:2}, or {resolverKey:"cost-center-owner"} for CUSTOM_RULE.
  approverResolutionConfig Json?
  quorumMode               ApprovalQuorumMode              @default(ANY_ONE)
  /// Null = step always included. Set = evaluated against the instance's
  /// contextPayload at activation time — e.g. "Leave > 20 days -> CEO".
  conditionExpression      Json?
  /// If resolution yields zero eligible approvers: true = skip this
  /// branch, false = fail-closed (a later phase escalates immediately).
  skipIfNoApproverResolved Boolean                         @default(false)
  /// True = this branch never blocks progress to the next stepOrder, even
  /// while its decision is still PENDING (an advisory/CC-style step,
  /// distinct from conditionExpression's data-driven inclusion). A later
  /// phase's engine reads this; Phase 4B only persists it.
  isOptional               Boolean                         @default(false)
  slaHours                 Int?
  /// Opaque canvas node metadata (position, color, notes) for a future
  /// visual Workflow Builder — never read by any engine logic.
  uiMetadata               Json?
  createdAt                DateTime                        @default(now())

  stepInstances ApprovalStepInstance[]

  @@unique([workflowVersionId, stepOrder, branchKey])
  @@index([workflowVersionId])
  @@map("approval_step_definitions")
}

/// The runtime case — one per real-world request (one Leave Request's
/// approval run, one Expense Request's, ...). entityType/entityId is a
/// soft pointer only; this model has no idea what a LEAVE_REQUEST is.
/// companyId/branchId/departmentId are denormalized copies of
/// contextPayload's scoping keys purely so reporting/pending-approval
/// queries at 100k+ employee scale stay index-only scans.
model ApprovalInstance {
  id                   String                    @id @default(cuid())
  entityType           String
  entityId             String
  workflowDefinitionId String
  workflowVersionId    String
  workflowVersion      ApprovalWorkflowVersion    @relation(fields: [workflowVersionId], references: [id])
  status               ApprovalInstanceStatus     @default(PENDING)
  currentStepOrder     Int?
  contextPayload       Json
  companyId            String?
  branchId             String?
  departmentId         String?
  /// "{entityType}::{entityId}" while status is non-terminal, null once
  /// terminal — the @unique constraint below is what actually enforces
  /// "one active instance per subject" at the database level (Phase 4C
  /// fixed the earlier service-layer-only version of this invariant, which
  /// couldn't close a create/create race between two concurrent
  /// submissions). Maintained exclusively by the engine service, never set
  /// directly by a repository caller.
  activeKey            String?                    @unique
  submittedBy          String
  submittedAt          DateTime                   @default(now())
  decidedAt            DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  stepInstances ApprovalStepInstance[]
  actions       ApprovalAction[]

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([status])
  @@map("approval_instances")
}

/// Runtime state of one branch. activatedAt/decidedAt/dueAt are what
/// reporting and a later escalation sweep both read.
model ApprovalStepInstance {
  id                 String                      @id @default(cuid())
  approvalInstanceId String
  approvalInstance   ApprovalInstance            @relation(fields: [approvalInstanceId], references: [id])
  stepDefinitionId   String
  stepDefinition     ApprovalStepDefinition      @relation(fields: [stepDefinitionId], references: [id])
  stepOrder          Int
  branchKey          String
  status             ApprovalStepInstanceStatus  @default(PENDING)
  activatedAt        DateTime?
  dueAt              DateTime?
  decidedAt          DateTime?
  escalationLevel    Int                         @default(0)
  /// Why this branch is SKIPPED — open vocabulary (plain String, same
  /// judgment already applied to LeaveAuditLogEntry.action), e.g.
  /// "CONDITION_NOT_MET" | "NO_APPROVER_RESOLVED" | "INSTANCE_TERMINATED".
  /// Null for every other status. This is what lets the engine tell
  /// "excluded by data-driven condition" (normal) apart from "was supposed
  /// to matter but couldn't" (drives PARTIALLY_APPROVED) apart from "its
  /// parent instance ended before it could decide" (cancel/reject
  /// force-termination) — three different facts that would otherwise all
  /// collapse into the same SKIPPED status.
  skipReason         String?
  createdAt          DateTime                    @default(now())

  approvers ApprovalStepApprover[]

  @@index([approvalInstanceId])
  @@index([status, dueAt])
  @@map("approval_step_instances")
}

/// Resolved on activation (not at submission) — DIRECT_MANAGER etc. reflect
/// who the manager IS right now, including any delegation active at that
/// moment. This is what "my pending approvals" queries hit.
model ApprovalStepApprover {
  id                      String                @id @default(cuid())
  approvalStepInstanceId  String
  approvalStepInstance    ApprovalStepInstance  @relation(fields: [approvalStepInstanceId], references: [id])
  approverEmployeeId      String
  isDelegate              Boolean               @default(false)
  delegatedFromEmployeeId String?
  decision                ApprovalDecision      @default(PENDING)
  decidedAt               DateTime?
  comment                 String?
  viewedAt                DateTime?
  createdAt               DateTime              @default(now())

  @@index([approverEmployeeId, decision])
  @@index([approvalStepInstanceId])
  @@map("approval_step_approvers")
}

/// The immutable audit trail for the engine's own lifecycle — append-only,
/// no update path, same discipline as LeaveLedgerEntry/LeaveAuditLogEntry.
/// Deliberately not shaped like LeaveAuditLogEntry's entityType/entityId
/// pair: it always belongs to exactly one ApprovalInstance (which already
/// carries entityType/entityId), so referencing approvalInstanceId
/// directly avoids duplicating the polymorphic columns. This is the
/// engine's own action log, not a substitute for a module's business audit
/// trail (e.g. LeaveAuditLogEntry keeps recording Leave-specific facts
/// like "leave_type.created" independently).
model ApprovalAction {
  id                     String              @id @default(cuid())
  approvalInstanceId     String
  approvalInstance       ApprovalInstance    @relation(fields: [approvalInstanceId], references: [id])
  approvalStepInstanceId String?
  actionType             ApprovalActionType
  actorEmployeeId        String
  comment                String?
  metadata               Json?
  createdAt              DateTime            @default(now())

  @@index([approvalInstanceId])
  @@index([actorEmployeeId])
  @@map("approval_actions")
}

/// Who stands in for whom, when, and why. scopeEntityType is nullable and
/// unconstrained (null = applies to every entity type) — same "no master
/// list" reasoning as ApprovalInstance.entityType.
model ApprovalDelegation {
  id                  String                    @id @default(cuid())
  delegatorEmployeeId String
  delegateEmployeeId  String
  reason              ApprovalDelegationReason
  scopeEntityType     String?
  startDate           DateTime
  endDate             DateTime?
  active              Boolean                   @default(true)
  createdBy           String
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([delegatorEmployeeId, active])
  @@map("approval_delegations")
}

/// Authoring-side audit trail — who created/updated/published/cloned a
/// workflow definition, version, or step graph. Deliberately the same
/// entityType/entityId/action/actor shape as LeaveAuditLogEntry (this
/// engine's master-data equivalent of Leave's own generic audit table),
/// and deliberately a SEPARATE table from ApprovalAction: ApprovalAction
/// is scoped to one ApprovalInstance's runtime lifecycle (its
/// approvalInstanceId FK is NOT NULL), while authoring changes belong to
/// the Definition/Version/Step aggregate cluster and have no instance to
/// attach to. Append-only, same discipline as every other audit table in
/// this codebase.
model ApprovalWorkflowAuditLogEntry {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  action     String
  actor      String
  timestamp  DateTime @default(now())
  field      String?
  oldValue   String?
  newValue   String?

  @@index([entityType, entityId])
  @@map("approval_workflow_audit_log_entries")
}
